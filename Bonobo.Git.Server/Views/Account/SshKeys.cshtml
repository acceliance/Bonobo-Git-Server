@model Bonobo.Git.Server.Models.SshKeyListModel
@{
    ViewBag.Title = Resources.Account_SshKeys_Title;
}
@if (Model == null)
{
    @Html.Partial("~/Views/Shared/_ItemNotFound.cshtml")
}
else
{
    <text>
    <h1>@Model.Username</h1>
    <h2>@Resources.Account_SshKeys_Title</h2>

    @if (TempData["SshKeyAddSuccess"] != null && (bool)TempData["SshKeyAddSuccess"])
    {
        <div class="summary-success">
            <p>@Resources.Account_SshKeys_AddSuccess</p>
        </div>
    }

    @if (TempData["SshKeyDeleteSuccess"] != null && (bool)TempData["SshKeyDeleteSuccess"])
    {
        <div class="summary-success">
            <p>@Resources.Account_SshKeys_DeleteSuccess</p>
        </div>
    }

    @if (!UserConfiguration.Current.HasSshConfigured)
    {
        <div class="summary-error">
            <p>@Resources.Account_SshKeys_NotConfigured</p>
        </div>
    }

    @if (Model.Keys.Count == 0)
    {
        <p>@Resources.Account_SshKeys_Empty</p>
    }
    else
    {
        <table class="pure-table pure-table-horizontal repositories">
            <thead>
                <tr>
                    <th>@Resources.Account_SshKeys_Name</th>
                    <th>@Resources.Account_SshKeys_Fingerprint</th>
                    <th>@Resources.Account_SshKeys_Added</th>
                    <th>@Resources.Account_SshKeys_LastUsed</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var key in Model.Keys)
                {
                    <tr>
                        <td>@key.Name</td>
                        <td>
                            <code class="ssh-fingerprint">@key.Fingerprint</code>
                            <span class="ssh-keytype">@key.KeyType (@key.KeySize)</span>
                        </td>
                        <td>@key.CreatedAt.ToLocalTime().ToString("d")</td>
                        <td>
                            @if (key.LastUsed.HasValue)
                            {
                                @key.LastUsed.Value.ToLocalTime().ToString("d")
                            }
                            else
                            {
                                @Resources.Account_SshKeys_NeverUsed
                            }
                        </td>
                        <td>
                            @using (Html.BeginForm("DeleteSshKey", "Account", new { id = Model.UserId }, FormMethod.Post, new { @class = "inline-form" }))
                            {
                                @Html.AntiForgeryToken()
                                @Html.Hidden("keyId", key.Id)
                                <button type="submit" class="pure-button" onclick="return confirm('@Resources.Account_SshKeys_DeleteConfirm');">
                                    <i class="fa fa-trash-o"></i> @Resources.Account_SshKeys_Delete
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h2>@Resources.Account_SshKeys_Add</h2>
    <p class="ssh-hint">@Resources.Account_SshKeys_Hint</p>

    @using (Html.BeginForm("AddSshKey", "Account", FormMethod.Post, new { @class = "pure-form pure-form-aligned" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(false)
        @Html.HiddenFor(m => m.NewKey.UserId)

        <fieldset>
            <div class="pure-control-group">
                @Html.LabelFor(m => m.NewKey.Name)
                @Html.TextBoxFor(m => m.NewKey.Name, new { @class = "medium", autofocus = "" })<em>*</em>
                @Html.ValidationMessageFor(m => m.NewKey.Name)
            </div>
            <div class="pure-control-group">
                @Html.LabelFor(m => m.NewKey.PublicKey)
                @Html.TextAreaFor(m => m.NewKey.PublicKey, new { @class = "ssh-key-input", rows = 5, spellcheck = "false" })<em>*</em>
                @Html.ValidationMessageFor(m => m.NewKey.PublicKey)
            </div>
        </fieldset>
        <div class="pure-controls">
            <a class="pure-button" href="@Url.Action("Detail", new { id = Model.UserId })"><i class="fa fa-long-arrow-left"></i> @Resources.Account_Detail_Back</a>
            <button type="submit" class="pure-button pure-button-primary"><i class="fa fa-plus-circle"></i> @Resources.Account_SshKeys_Add</button>
        </div>
    }
    </text>
}
